# Nginx reverse proxy configuration
# Optimized for web/API traffic (HTTP/HTTPS)


        #***************************
        #*       CONNECTIONS       *
        #***************************

        #1 Core = 1 Worker
        worker_processes {{ worker_processes }};

events {
        worker_connections {{ worker_connections }};
}


http {

        #********************************************************************************
        #                                                                               *
        #                                  PERFORMANCE                                  *
        #                                                                               *
        #********************************************************************************

        #**************************
        #*   TIMEOUTS & LIMITS    *
        #**************************

        #Buffer size for Post submissions
        client_body_buffer_size {{ client_body_buffer_size }};
        client_max_body_size {{ client_max_body_size }};

        #Buffer size for Headers
        client_header_buffer_size {{ client_header_buffer_size }};

        #Max time to receive client headers/body.
        client_body_timeout {{ client_body_timeout }};
        client_header_timeout {{ client_header_timeout }};

        #Max time to keep a connection open for.
        keepalive_timeout {{ keep_alive_timeout }};

        #Max time for the client to accept, receive a response
        send_timeout {{ send_timeout }};


        #**************************
        #*          GZIP          *
        #**************************

        gzip {{ gzip }};
        gzip_comp_level {{ gzip_comp_level }};

        gzip_types text/css text/plain application/json application/javascript text/xml;


        #********************************************************************************
        #                                                                               *
        #                                   SECURITY                                    *
        #                                                                               *
        #********************************************************************************


        #**************************
        #*       RATE LIMIT       *
        #**************************

        limit_req_zone $binary_remote_addr zone={{ zone }}:{{ sizeIPs }} rate={{ rate }};
        limit_req_status 429;
        limit_req_log_level warn;


        #**************************
        #*        HARDENING       *
        #**************************

        server_tokens off;
        add_header X-Frame-Options "SAME-ORIGIN" always;
        add_header X-XSS-Protection "1; mode=block" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; object-src 'none';" always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;



      upstream web_backend {
        {% for server in web_backend %}
        server {{ server }};
        {% endfor %}
      }


      server {

        server_name {{ server_name }};
        listen 443 ssl http2;


        #********************************************************************************
        #                                                                               *
        #                                    SECURITY                                   *
        #                                                                               *
        #********************************************************************************


        #**************************
        #*         SSL/TLS        *
        #**************************

        ssl_certificate {{ ssl_certificate_path }};
        ssl_certificate_key {{ ssl_certificate_key_path }};
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_dhparam {{ ssl_dhparam }};
        ssl_prefer_server_ciphers {{ ssl_prefer_server_ciphers }};
        ssl_ciphers {{ ssl_ciphers }};

# OCSP Stapling - disabled for self-signed certificates.
# Enable when using certificates from a real CA (e.g. Let's Encrypt).

#       ssl_stapling on;
#       ssl_stapling_verify on;

        location / {

                limit_req zone={{ zone }} burst={{ burst }} nodelay;

                proxy_pass {{ proxy_pass }};

                proxy_set_header Host $host;
                proxy_set_header X-Real-IP $remote_addr;
                proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
                proxy_set_header X-Forwarded-Proto $scheme;

                proxy_read_timeout 60s;

                proxy_connect_timeout 10s;
                proxy_send_timeout 60s;
        }
      }

      server{
        listen 80;
        server_name {{ server_name }};
        return 301 https://$host$request_uri;
      }
}